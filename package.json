  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashhart/Duo.git"
  },
  "homepage": "https://github.com/ashhart/Duo#readme",
  "bugs": {
    "url": "https://github.com/ashhart/Duo/issues"
  },
