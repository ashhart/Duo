{
  "name": "omp-local-duo",
  "version": "0.5.3",
  "description": "Two models, one workspace: talk, agree on a plan, and build together in OMP.",
  "type": "module",
  "private": true,
  "keywords": [
    "omp-plugin",
    "omp",
    "multi-agent",
    "local-llm"
  ],
  "files": [
    "src",
    "agents",
    "README.md",
    "docs",
    "assets"
  ],
  "omp": {
    "name": "Duo",
